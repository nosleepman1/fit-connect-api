# Application Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=fitconnect
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/fitconnect?schema=public"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Authentication
SECRET_KEY="your-super-secret-key-change-in-production"
JWT_SECRET="your-jwt-secret-key-change-in-production"
SALT_ROUNDS=10

# Mail Configuration (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@fitconnect.local
MAIL_PASSWORD=your_mail_password
MAIL_FROM="FitConnect <no-reply@fitconnect.local>"

# pgAdmin (Optional - for Docker Compose)
PGADMIN_DEFAULT_EMAIL=admin@fitconnect.local
PGADMIN_DEFAULT_PASSWORD=admin_secure_password